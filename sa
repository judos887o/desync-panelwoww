local function saveSettings()
    local data = {
        KeyBind = getgenv().KeyBind.Name,
        Direction = getgenv().DirectionToShoot,
        DesyncOn = getgenv().Desync
    }
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadSettings()
    pcall(function()
        if isfile(SAVE_FILE) then
            local raw = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(raw)
            if data.KeyBind then
                local ok, keycode = pcall(function() return Enum.KeyCode[data.KeyBind] end)
                if ok and keycode then
                    getgenv().KeyBind = keycode
                end
            end
            if data.Direction then
                getgenv().DirectionToShoot = data.Direction
            end
            if data.DesyncOn ~= nil then
                getgenv().Desync = data.DesyncOn
            end
        end
    end)
end


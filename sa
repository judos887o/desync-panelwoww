        if PanelGui then PanelGui:Destroy() end
        if LocalPlayer.PlayerGui:FindFirstChild("DesyncNotifyGui") then
            LocalPlayer.PlayerGui.DesyncNotifyGui:Destroy()
        end
        removeServerBall()
        if cleanupListener then cleanupListener:Disconnect() end
        if Shared.Connections[key] then

local function executeRaknetHook()
    return pcall(function()
        raknet.add_send_hook(function(packet)
            if packet.PacketId == 0x1B then
                local data = packet.AsBuffer
                buffer.writeu32(data, 1, 0xFFFFFFFF)
                packet:SetData(data)
            end
        end)
    end)
end

ActivateBtn.MouseButton1Click:Connect(function()
    playClick()

    if DesyncActivated then
        showDesyncNotification("Desync is already activated!", "on", 3)
        return
    end

    DesyncActivateCount = DesyncActivateCount + 1

    if DesyncActivateCount == 1 then
        showDesyncNotification("Use Delta / Synapse Z / Potassium / Seliware / Volt with RakNet library enabled, otherwise it won't work!", "warn", 8)
        executeRaknetHook()
        ActivateBtn.Text = "Press Again to Confirm"
        TweenService:Create(ActivateBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 150, 30)}):Play()
        return
    end

    if DesyncActivateCount >= 2 then
        local success = executeRaknetHook()

        if success then
            DesyncActivated = true
            ActivateBtn.Text = "Performing Sequence..."
            TweenService:Create(ActivateBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 150, 30)}):Play()
            showDesyncNotification("Performing desync sequence...", "warn", 3)

            task.spawn(function()
                performDesyncSequence()
                createServerBall()

                ActivateBtn.Text = "Desync Activated"
                TweenService:Create(ActivateBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(40, 120, 40)}):Play()
                showDesyncNotification("Desync successfully activated!", "on", 4)
            end)
        else
            DesyncActivateCount = 0
            ActivateBtn.Text = "Activate Desync"
            TweenService:Create(ActivateBtn, TweenInfo.new(0.3), {BackgroundColor3 = COL.ButtonBg}):Play()
            showDesyncNotification("Failed! RakNet Library not found. Enable it in your executor.", "off", 6)
        end
    end
end)


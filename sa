local function getCrouchAnimation()
    local animationsFolder = ReplicatedStorage:FindFirstChild("Animations")
    if animationsFolder then
        local crouchAnim = animationsFolder:FindFirstChild("crouch")
        if crouchAnim then
            return crouchAnim
        end
        for _, child in pairs(animationsFolder:GetChildren()) do
            if child.Name:lower():find("crouch") then
                return child
            end
        end
    end
    for _, child in pairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("Animation") and child.Name:lower():find("crouch") then
            return child
        end
    end
    return nil
end

local function findKatanaTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("katana") then
                return tool
            end
        end
    end
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("katana") then
                return tool
            end
        end
    end
    return nil
end

local function performDesyncSequence()
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local crouchAnimation = getCrouchAnimation()
    local crouchTrack = nil

    if crouchAnimation then
        crouchTrack = animator:LoadAnimation(crouchAnimation)
        crouchTrack:Play()
    end

    task.wait(0.3)

    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

    task.wait(0.2)

    local katana = findKatanaTool()
    if katana then
        if katana.Parent == LocalPlayer.Backpack then
            humanoid:EquipTool(katana)
        end
    end

    task.wait(0.3)

    if crouchTrack then
        crouchTrack:Stop()
    end

    task.wait(0.2)

    updateServerBallPosition()

    return true
end

